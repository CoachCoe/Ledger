{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/workspace.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent_id",
    "session_id",
    "capability_id",
    "change_id",
    "base_tree",
    "base_line_advance",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../v1/common.json#/$defs/workspace_id"
    },
    "intent_id": {
      "$ref": "../v1/common.json#/$defs/intent_id"
    },
    "session_id": {
      "$ref": "../v1/common.json#/$defs/session_id"
    },
    "capability_id": {
      "$ref": "../v1/common.json#/$defs/capability_id"
    },
    "change_id": {
      "$ref": "../v1/common.json#/$defs/change_id"
    },
    "base_tree": {
      "$ref": "common.json#/$defs/object_id"
    },
    "base_line_advance": {
      "anyOf": [
        {
          "$ref": "../v1/common.json#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "../v1/common.json#/$defs/timestamp"
    }
  },
  "title": "Workspace creation"
}
