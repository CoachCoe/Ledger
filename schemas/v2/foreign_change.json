{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/foreign_change.json",
  "title": "Foreign change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "line",
    "participant",
    "mapping",
    "base_tree",
    "tree",
    "actor",
    "at"
  ],
  "properties": {
    "line": {
      "$ref": "common.json#/$defs/line"
    },
    "participant": {
      "const": "bridge"
    },
    "mapping": {
      "$ref": "../v1/common.json#/$defs/hash"
    },
    "base_tree": {
      "$ref": "common.json#/$defs/object_id"
    },
    "tree": {
      "$ref": "common.json#/$defs/object_id"
    },
    "actor": {
      "$ref": "../v1/common.json#/$defs/hash"
    },
    "at": {
      "$ref": "../v1/common.json#/$defs/timestamp"
    }
  }
}
