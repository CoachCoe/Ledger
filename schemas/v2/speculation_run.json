{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/speculation_run.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent_id",
    "strategies",
    "attempts",
    "checks",
    "scorer",
    "scorer_definition",
    "base_tree",
    "deadline",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../v1/common.json#/$defs/run_id"
    },
    "intent_id": {
      "$ref": "../v1/common.json#/$defs/intent_id"
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "spec"
        ],
        "properties": {
          "name": {
            "$ref": "../v1/common.json#/$defs/name"
          },
          "spec": {
            "$ref": "../v1/common.json#/$defs/text"
          }
        },
        "title": "Strategy"
      },
      "minItems": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workspace_id",
          "strategy"
        ],
        "properties": {
          "workspace_id": {
            "$ref": "../v1/common.json#/$defs/workspace_id"
          },
          "strategy": {
            "$ref": "../v1/common.json#/$defs/name"
          }
        },
        "title": "Candidate binding"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "checks": {
      "allOf": [
        {
          "$ref": "../v1/common.json#/$defs/hashes"
        },
        {
          "minItems": 1
        }
      ]
    },
    "scorer": {
      "$ref": "../v1/common.json#/$defs/hash"
    },
    "scorer_definition": {
      "$ref": "#/$defs/scorer_definition"
    },
    "base_tree": {
      "$ref": "common.json#/$defs/object_id"
    },
    "deadline": {
      "$ref": "../v1/common.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "../v1/common.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "scorer_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "command",
        "env_allowlist",
        "timeout_seconds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "submission"
          ]
        },
        "command": {
          "$ref": "../v1/common.json#/$defs/nullable_text"
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "uniqueItems": true
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "submission"
            },
            "command": {
              "type": "null"
            },
            "env_allowlist": {
              "maxItems": 0
            },
            "timeout_seconds": {
              "type": "null"
            }
          }
        }
      ],
      "title": "Scorer definition"
    }
  },
  "title": "Speculation run creation"
}
