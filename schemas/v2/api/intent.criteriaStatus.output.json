{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/intent.criteriaStatus.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "$ref": "../../v1/common.json#/$defs/intent_id"
        },
        "manifest": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "evidence_set": {
          "$ref": "../../v1/common.json#/$defs/hashes"
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "criterion_id": {
                "$ref": "../../v1/common.json#/$defs/name"
              },
              "status": {
                "enum": [
                  "satisfied",
                  "failed",
                  "outstanding"
                ]
              },
              "deciding": {
                "$ref": "../../v1/common.json#/$defs/hashes"
              },
              "conflicting": {
                "$ref": "../../v1/common.json#/$defs/hashes"
              }
            },
            "required": [
              "criterion_id",
              "status",
              "deciding",
              "conflicting"
            ]
          }
        },
        "contrary_evidence": {
          "$ref": "../../v1/common.json#/$defs/hashes"
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hash": {
                "$ref": "../../v1/common.json#/$defs/hash"
              },
              "criterion_id": {
                "$ref": "../../v1/common.json#/$defs/name"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "hash",
              "criterion_id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "intent_id",
        "manifest",
        "evidence_set",
        "criteria",
        "contrary_evidence",
        "rejected"
      ]
    }
  }
}
