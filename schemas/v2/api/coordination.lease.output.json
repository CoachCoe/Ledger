{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/coordination.lease.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "const": true
        },
        "observed_at": {
          "$ref": "../../v1/common.json#/$defs/timestamp"
        },
        "snapshot_digest": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "lease": {
          "$ref": "../../v1/runtime/lease.json"
        }
      },
      "required": [
        "runtime",
        "observed_at",
        "snapshot_digest",
        "lease"
      ]
    }
  }
}
