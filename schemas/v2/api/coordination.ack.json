{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "$ref": "../../v1/common.json#/$defs/session_id"
    },
    "notification_id": {
      "type": "string",
      "pattern": "^ntf_[0-9a-z]{26}$"
    },
    "notification_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ntf_[0-9a-z]{26}$"
      }
    }
  },
  "required": [
    "session_id"
  ],
  "oneOf": [
    {
      "required": [
        "notification_id"
      ]
    },
    {
      "required": [
        "notification_ids"
      ]
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/coordination.ack.json"
}
