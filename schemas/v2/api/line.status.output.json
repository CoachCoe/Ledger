{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/line.status.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": {
          "$ref": "../common.json#/$defs/line"
        },
        "advance": {
          "anyOf": [
            {
              "$ref": "../../v1/common.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "tree": {
          "$ref": "../common.json#/$defs/object_id"
        }
      },
      "required": [
        "line",
        "advance",
        "tree"
      ]
    }
  }
}
