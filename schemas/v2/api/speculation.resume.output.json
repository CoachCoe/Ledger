{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/speculation.resume.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "$ref": "response.json#/$defs/mutation_result",
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "$ref": "../../v1/common.json#/$defs/run_id"
            },
            "state": {
              "enum": [
                "collecting",
                "evaluating"
              ]
            }
          },
          "required": [
            "run_id",
            "state"
          ]
        }
      }
    }
  }
}
