{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/coordination.nearby.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "const": true
        },
        "unsigned": {
          "const": true
        },
        "observed_at": {
          "$ref": "../../v1/common.json#/$defs/timestamp"
        },
        "snapshot_digest": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workspace_id": {
                "$ref": "../../v1/common.json#/$defs/workspace_id"
              },
              "intent_id": {
                "$ref": "../../v1/common.json#/$defs/intent_id"
              },
              "session_id": {
                "$ref": "../../v1/common.json#/$defs/session_id"
              },
              "state": {
                "enum": [
                  "open",
                  "proposed"
                ]
              },
              "tree": {
                "$ref": "../common.json#/$defs/object_id"
              },
              "analysis": {
                "$ref": "../../v1/runtime/symbol_analysis.json"
              }
            },
            "required": [
              "workspace_id",
              "intent_id",
              "session_id",
              "state",
              "tree",
              "analysis"
            ]
          }
        },
        "leases": {
          "type": "array",
          "items": {
            "$ref": "../../v1/runtime/lease.json"
          }
        }
      },
      "required": [
        "runtime",
        "unsigned",
        "observed_at",
        "snapshot_digest",
        "workspaces",
        "leases"
      ]
    }
  }
}
