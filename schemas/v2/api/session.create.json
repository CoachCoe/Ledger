{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "participant_kind": {
      "enum": [
        "human",
        "agent",
        "service"
      ]
    },
    "expires_at": {
      "$ref": "../../v1/common.json#/$defs/timestamp"
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "deny": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "may_add_dependencies": {
      "type": "boolean"
    }
  },
  "required": [],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/session.create.json"
}
