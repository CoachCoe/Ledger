{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/workspace.restore.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "const": true
        },
        "unsigned": {
          "const": true
        },
        "observed_at": {
          "$ref": "../../v1/common.json#/$defs/timestamp"
        },
        "snapshot_digest": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "workspace_id": {
          "$ref": "../../v1/common.json#/$defs/workspace_id"
        },
        "entry": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "$ref": "../../v1/common.json#/$defs/hash"
        },
        "tree": {
          "$ref": "../common.json#/$defs/object_id"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "../../v1/common.json#/$defs/path"
          }
        }
      },
      "required": [
        "runtime",
        "unsigned",
        "observed_at",
        "snapshot_digest",
        "workspace_id",
        "entry",
        "seq",
        "source",
        "tree",
        "files"
      ]
    }
  }
}
