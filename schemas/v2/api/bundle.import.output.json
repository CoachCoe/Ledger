{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/bundle.import.output.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "import": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verification": {
          "$ref": "bundle.verify.output.json"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string"
              },
              "commit": {
                "$ref": "../../v1/common.json#/$defs/git_oid"
              },
              "status": {
                "enum": [
                  "created",
                  "present",
                  "ref_conflict"
                ]
              },
              "local": {
                "$ref": "../../v1/common.json#/$defs/git_oid"
              }
            },
            "required": [
              "ref",
              "commit",
              "status"
            ]
          }
        },
        "records": {
          "type": "integer",
          "minimum": 0
        },
        "already_present": {
          "type": "boolean"
        },
        "publish": {
          "type": "object"
        },
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "oplogs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspace",
              "head",
              "status"
            ],
            "properties": {
              "workspace": {
                "$ref": "../../v1/common.json#/$defs/workspace_id"
              },
              "head": {
                "$ref": "../../v1/common.json#/$defs/hash"
              },
              "status": {
                "enum": [
                  "created",
                  "present",
                  "oplog_conflict"
                ]
              }
            }
          }
        }
      },
      "required": [
        "verification",
        "refs",
        "records",
        "already_present",
        "publish"
      ]
    },
    "index_digest": {
      "type": "string"
    }
  },
  "required": [
    "import",
    "index_digest"
  ]
}
