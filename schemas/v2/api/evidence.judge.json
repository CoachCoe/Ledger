{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/api/evidence.judge.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "../../v1/common.json#/$defs/hash"
    },
    "criterion_id": {
      "$ref": "../../v1/common.json#/$defs/name"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "reason": {
      "$ref": "../../v1/common.json#/$defs/text"
    }
  },
  "required": [
    "manifest",
    "criterion_id",
    "result"
  ]
}
