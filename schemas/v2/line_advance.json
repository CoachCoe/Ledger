{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v2/line_advance.json",
  "title": "Line advance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "line",
    "previous",
    "actor",
    "at"
  ],
  "properties": {
    "line": {
      "$ref": "common.json#/$defs/line"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "../v1/common.json#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "$ref": "../v1/common.json#/$defs/hash"
    },
    "selection": {
      "$ref": "../v1/common.json#/$defs/hash"
    },
    "actor": {
      "$ref": "../v1/common.json#/$defs/principal"
    },
    "at": {
      "$ref": "../v1/common.json#/$defs/timestamp"
    },
    "foreign_change": {
      "$ref": "../v1/common.json#/$defs/hash"
    }
  },
  "oneOf": [
    {
      "required": [
        "manifest",
        "selection"
      ],
      "not": {
        "required": [
          "foreign_change"
        ]
      }
    },
    {
      "required": [
        "foreign_change"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "manifest"
            ]
          },
          {
            "required": [
              "selection"
            ]
          }
        ]
      }
    }
  ]
}
