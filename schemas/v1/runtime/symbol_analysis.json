{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "advisory": {
      "const": true
    },
    "written": {
      "$ref": "../common.json#/$defs/symbols"
    },
    "read": {
      "$ref": "../common.json#/$defs/symbols"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "dependency_edge.json"
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "../common.json#/$defs/path"
          },
          "relation": {"enum":["read","write"]},
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "path",
          "reason"
        ]
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "../common.json#/$defs/symbol"
          },
          "name": {
            "type": "string",
            "maxLength": 20000
          },
          "confidence": {
            "const": "unresolved"
          },
          "shadowed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "advisory",
    "written",
    "read",
    "edges",
    "fallbacks",
    "unresolved"
  ],
  "$id": "https://schemas.ledger.invalid/v1/runtime/symbol_analysis.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
