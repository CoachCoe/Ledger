{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/runtime/run_handoff.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "$ref": "../common.json#/$defs/run_id"
    },
    "intent_id": {
      "$ref": "../common.json#/$defs/intent_id"
    },
    "state": {
      "const": "collecting"
    },
    "deadline": {
      "$ref": "../common.json#/$defs/timestamp"
    },
    "scorer": {
      "$ref": "../common.json#/$defs/hash"
    },
    "base_commit": {
      "$ref": "../common.json#/$defs/git_oid"
    },
    "checks": {
      "$ref": "../common.json#/$defs/hashes"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workspace_id": {
            "$ref": "../common.json#/$defs/workspace_id"
          },
          "session_id": {
            "$ref": "../common.json#/$defs/session_id"
          },
          "capability_id": {
            "$ref": "../common.json#/$defs/capability_id"
          },
          "strategy": {
            "$ref": "../common.json#/$defs/name"
          },
          "spec": {
            "$ref": "../common.json#/$defs/text"
          },
          "path": {
            "$ref": "../common.json#/$defs/path"
          }
        },
        "required": [
          "workspace_id",
          "session_id",
          "capability_id",
          "strategy",
          "spec",
          "path"
        ]
      }
    }
  },
  "required": [
    "run_id",
    "intent_id",
    "state",
    "deadline",
    "scorer",
    "base_commit",
    "checks",
    "attempts"
  ],
  "title": "Speculation run handoff"
}
