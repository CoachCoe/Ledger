{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/api/evidence.resolve.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "$ref": "../common.json#/$defs/change_id"
        }
      },
      "required": [
        "change_id"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "$ref": "../common.json#/$defs/hash"
        },
        "commit": {
          "$ref": "../common.json#/$defs/git_oid"
        }
      },
      "required": [
        "manifest"
      ]
    }
  ]
}
