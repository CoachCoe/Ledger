{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/api/intent.status.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "creation": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "resume": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            },
            "binding_head": {
              "type": "string"
            },
            "conflict": {
              "type": "string"
            },
            "detail": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "kind",
            "creation",
            "state",
            "head",
            "resume",
            "owner",
            "binding_head",
            "conflict",
            "detail"
          ]
        },
        "intent": {
          "$ref": "../intent.json"
        }
      },
      "required": [
        "subject",
        "intent"
      ]
    }
  }
}
