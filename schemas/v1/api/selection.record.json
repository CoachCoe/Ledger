{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/api/selection.record.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "$ref": "../common.json#/$defs/hash"
    },
    "commit": {
      "$ref": "../common.json#/$defs/git_oid"
    },
    "evidence": {
      "$ref": "../common.json#/$defs/hashes"
    },
    "competitors": {
      "$ref": "../common.json#/$defs/hashes"
    },
    "scoring": {
      "type": "object"
    }
  },
  "required": [
    "manifest",
    "commit",
    "evidence"
  ]
}
