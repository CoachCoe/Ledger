{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/api/workspace.status.output.json",
  "$ref": "response.json",
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "$ref": "../common.json#/$defs/workspace_id"
        },
        "state": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "base_commit": {
          "$ref": "../common.json#/$defs/git_oid"
        },
        "write_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "observed_at": {
          "$ref": "../common.json#/$defs/timestamp"
        },
        "tree": {
          "$ref": "../common.json#/$defs/git_oid"
        }
      },
      "required": [
        "workspace_id",
        "state",
        "path"
      ]
    }
  }
}
