{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/speculation_run.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "intent_id",
    "strategies",
    "scorer",
    "deadline",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.json#/$defs/run_id"
    },
    "intent_id": {
      "$ref": "common.json#/$defs/intent_id"
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "spec"
        ],
        "properties": {
          "name": {
            "$ref": "common.json#/$defs/name"
          },
          "spec": {
            "$ref": "common.json#/$defs/text"
          }
        },
        "title": "Strategy"
      },
      "minItems": 1
    },
    "scorer": {
      "$ref": "common.json#/$defs/hash"
    },
    "deadline": {
      "$ref": "common.json#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "common.json#/$defs/timestamp"
    }
  },
  "title": "Speculation run creation"
}
