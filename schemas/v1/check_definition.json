{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ledger.invalid/v1/check_definition.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "category",
    "setup",
    "command",
    "working_directory",
    "env_allowlist",
    "timeout_seconds",
    "output_limit_bytes"
  ],
  "properties": {
    "name": {
      "$ref": "common.json#/$defs/name"
    },
    "category": {
      "enum": [
        "mechanical",
        "behavioral",
        "judgment"
      ]
    },
    "setup": {
      "$ref": "common.json#/$defs/nullable_text"
    },
    "command": {
      "$ref": "common.json#/$defs/text"
    },
    "working_directory": {
      "$ref": "common.json#/$defs/path"
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
      },
      "uniqueItems": true
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "output_limit_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1073741824
    }
  },
  "title": "Check definition"
}
