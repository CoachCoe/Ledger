# M2 capability and queue API through the shipped binary.
fixture polyglot repo
cd repo
exec git init -q
exec git add -A
exec git commit -qm base
exec ledger init
exec ledger session create '{"allow":["src/billing/**"],"deny":["src/billing/private/**"],"may_add_dependencies":false}'
jsonvar SID result.result.session_id
jsonvar CAP result.result.capability_id
exec ledger intent create '{"description":"M2 scope","criteria":[{"id":"r","statement":"review","verification":{"kind":"judgment","reviewer":"human"}}]}'
jsonvar INT result.result.intent_id
exec ledger workspace fork --session $SID {"intent_id":"$INT","capability_id":"$CAP"}
jsonvar WSP result.result.workspace_id
jsonvar WPATH result.result.path
cp tools/report.py $WPATH/unauthorized.py
! exec ledger workspace propose --session $SID {"workspace_id":"$WSP"}
stdout '"code": "scope_violation"'
exec ledger coordination notifications --session $SID {"session_id":"$SID"}
stdout '"kind": "scope_violation"'
jsonvar NTF result.notifications.0.id
exec ledger coordination ack --session $SID {"session_id":"$SID","notification_id":"$NTF"}
stdout '"acknowledged": true'
exec ledger daemon stop
exec ledger coordination notifications {"session_id":"$SID"}
stdout '"acknowledged_at": "'
exec ledger daemon stop
exec ledger reindex
stdout '"notifications": 1'
exec ledger coordination notifications {"session_id":"$SID"}
stdout '"kind": "scope_violation"'
exec ledger session recover '{"workspace_id":"'$WSP'","allow":["src/billing/**"],"may_add_dependencies":false}'
jsonvar NEW result.result.session_id
! exec ledger workspace propose --session $NEW {"workspace_id":"$WSP"}
stdout '"code": "scope_violation"'
rm $WPATH/unauthorized.py
cp src/billing/tax.js $WPATH/src/billing/added.js
exec ledger workspace propose --session $NEW {"workspace_id":"$WSP"}
stdout '"manifest":'
exec ledger daemon stop
